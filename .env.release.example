# Apple Developer credentials for code signing and notarization
# Copy this file to .env.release and fill in your values

# Required
APPLE_ID=your-apple-id@example.com
APPLE_TEAM_ID=YOUR_TEAM_ID

# Optional - defaults shown
# SIGNING_IDENTITY=Developer ID Application (YOUR_TEAM_ID)
# KEYCHAIN_PROFILE=AC_PASSWORD

# First-time setup: store credentials in keychain (more secure than env vars)
# Run this command once:
#   xcrun notarytool store-credentials "AC_PASSWORD" \
#     --apple-id "your-apple-id@example.com" \
#     --team-id "YOUR_TEAM_ID" \
#     --password "your-app-specific-password"
